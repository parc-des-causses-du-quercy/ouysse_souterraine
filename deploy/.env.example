# === Hydro Forecast API - Production ===

# Port expose sur l'hote
API_PORT=5000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Base de donnees des taches
TASK_DB_PATH=/app/data/tasks.db

# Chemins internes (ne pas modifier sauf montage custom)
CONFIGS_PATH=/app/configs/points
STATES_PATH=/app/states
BACKUPS_PATH=/app/backups

# Rate limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_FORECAST=10/minute

# Monitoring
PROMETHEUS_ENABLED=true

# Retention des backups d'etats (jours)
BACKUP_RETENTION_DAYS=7
